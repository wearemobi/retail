{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production custom domain: https://pos.mobiware.app
  "name": "ware-pos",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "pos.mobiware.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
